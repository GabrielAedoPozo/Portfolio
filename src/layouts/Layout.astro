---
import '@fontsource/onest';
import '../styles/global.css';
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Portafolio | Gabriel Aedo</title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>

	body {
		margin: 0;
		font-family: 'Onest', sans-serif;
		background-color: #00000e;
	}

	html {
		scroll-behavior: smooth;
	}

	/* Ocultar elementos animados inicialmente */
	[class*="animate-fade"],
	[class*="animate-slide"] {
		opacity: 0;
		transform: translateY(30px);
	}

	/* Animaciones específicas por dirección */
	[class*="animate-fade-up"] {
		transform: translateY(40px);
	}

	[class*="animate-fade-down"] {
		transform: translateY(-40px);
	}

	[class*="animate-fade-left"] {
		transform: translateX(40px);
	}

	[class*="animate-fade-right"] {
		transform: translateX(-40px);
	}

	/* Mostrar cuando están visibles con transición MUY suave */
	[class*="animate-fade"].animate-visible,
	[class*="animate-slide"].animate-visible {
		opacity: 1;
		transform: translate(0, 0);
		animation: none !important;
		transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
	}

	/* Delays más suaves y progresivos */
	[class*="animate-delay-100"].animate-visible {
		transition-delay: 0.1s !important;
	}

	[class*="animate-delay-200"].animate-visible {
		transition-delay: 0.2s !important;
	}

	[class*="animate-delay-300"].animate-visible {
		transition-delay: 0.3s !important;
	}

	[class*="animate-delay"][class*="400ms"].animate-visible {
		transition-delay: 0.4s !important;
	}

	[class*="animate-delay-500"].animate-visible {
		transition-delay: 0.5s !important;
	}

	[class*="animate-delay"][class*="600ms"].animate-visible {
		transition-delay: 0.6s !important;
	}

	[class*="animate-delay"][class*="700ms"].animate-visible {
		transition-delay: 0.7s !important;
	}

	[class*="animate-delay"][class*="800ms"].animate-visible {
		transition-delay: 0.8s !important;
	}

	[class*="animate-delay"][class*="900ms"].animate-visible {
		transition-delay: 0.9s !important;
	}

	[class*="animate-delay-1000"].animate-visible {
		transition-delay: 1s !important;
	}
</style>

<script>
	// IntersectionObserver con configuración más suave
	const observerOptions = {
		threshold: 0.05,
		rootMargin: '0px 0px -50px 0px'
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('animate-visible');
				observer.unobserve(entry.target);
			}
		});
	}, observerOptions);

	// Observar todos los elementos con clases de animación
	document.addEventListener('DOMContentLoaded', () => {
		const animatedElements = document.querySelectorAll('[class*="animate-fade"], [class*="animate-slide"]');
		animatedElements.forEach(el => observer.observe(el));
	});
</script>
