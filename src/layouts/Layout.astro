---
import '@fontsource/onest';
import '../styles/global.css';
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Portafolio | Gabriel Aedo</title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>

	body {
		margin: 0;
		font-family: 'Onest', sans-serif;
		background-color: #00000e;
	}

	html {
		scroll-behavior: smooth;
	}

	/* Ocultar elementos animados inicialmente */
	[class*="animate-fade"],
	[class*="animate-slide"] {
		opacity: 0;
	}

	/* Mostrar cuando están visibles */
	[class*="animate-fade"].animate-visible,
	[class*="animate-slide"].animate-visible {
		opacity: 1;
	}
</style>

<script>
	// IntersectionObserver para activar animaciones al entrar en viewport
	const observerOptions = {
		threshold: 0.1,
		rootMargin: '0px 0px -100px 0px'
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('animate-visible');
				observer.unobserve(entry.target);
			}
		});
	}, observerOptions);

	// Observar todos los elementos con clases de animación
	document.addEventListener('DOMContentLoaded', () => {
		const animatedElements = document.querySelectorAll('[class*="animate-fade"], [class*="animate-slide"]');
		animatedElements.forEach(el => observer.observe(el));
	});
</script>
